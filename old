NAME := push_swap.a
LIBFT := libft/libft.a

SOURCES := $(wildcard *.c)
OBJECTS := $(SOURCES:.c=.o)

CC := cc
CFLAGS := -Wall -Wextra -Werror -g3

AR := ar
ARFLAGS := -rcs

RM := rm -f

$(LIBFT):
	@$(MAKE) -C libft

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

$(NAME): $(LIBFT) $(OBJECTS)
	$(AR) $(ARFLAGS) $(NAME) $(OBJECTS)

all: $(NAME)

# bonus: $(OBJECTS_BONUS)
# 	$(AR) -d $(NAME) $(OBJECTS) 2>/dev/null || true
# 	$(AR) $(ARFLAGS) $(NAME) $(OBJECTS_BONUS)

clean:
	@$(MAKE) clean -C ./libft
	$(RM) $(OBJECTS)


fclean:	clean
	@$(MAKE) clean -C ./libft
	$(RM) $(NAME) $(LIBFT)

re:	fclean all

.PHONY: all clean fclean re	
# must clean BONUS!!