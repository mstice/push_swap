NAME := push_swap.a

LIBFT := libft/libft.a

SOURCES := $(wildcard *.c)

OBJECTS := $(SOURCES:.c=.o)

# SOURCES_BONUS := 	get_next_line_bonus.c \
# 					get_next_line_utils_bonus.c \
# 					main.c

# OBJECTS_BONUS := $(SOURCES_BONUS:.c=.o)

CC := cc

CFLAGS := -Wall -Wextra -Werror -g3

AR := ar

ARFLAGS := -rcs

RM := rm -f

$(LIBFT):
	@$(MAKE) -C ./libft

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

$(NAME): $(LIBFT) $(OBJECTS)
	$(AR) $(ARFLAGS) $(NAME) $(LIBFT) $(OBJECTS)

all: $(NAME)

# bonus: $(OBJECTS_BONUS)
# 	$(AR) -d $(NAME) $(OBJECTS) 2>/dev/null || true
# 	$(AR) $(ARFLAGS) $(NAME) $(OBJECTS_BONUS)

clean:
	@$(MAKE) clean -C ./libft
	$(RM) $(OBJECTS)

# clean_bonus: 
# 	$(RM) $(OBJECTS_BONUS)

fclean:	clean #clean_bonus
	@$(MAKE) clean -C ./libft
	$(RM) $(NAME)

re:	fclean all

.PHONY: all bonus clean clean_bonus fclean re	
